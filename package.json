{
  "name": "traceglass",
  "version": "1.0.0",
  "description": "Local browser traffic capture and inspection workspace",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test tests/*.test.js",
    "setup:browser": "playwright install chromium",
    "setup:httpx": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-httpx.ps1",
    "doctor": "node scripts/doctor.js",
    "check": "node scripts/check.js",
    "release:check": "node scripts/release-check.js",
    "test:unit": "node --test tests/runtime.test.js"
  },
  "keywords": [
    "http",
    "traffic-inspection",
    "reconnaissance",
    "playwright",
    "security-testing"
  ],
  "author": "",
  "license": "GPL-3.0-only",
  "type": "commonjs",
  "dependencies": {
    "acorn": "^8.19.0",
    "acorn-loose": "^8.5.2",
    "archiver": "^8.0.0",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "express": "^5.3.0",
    "playwright": "^1.65.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
